# Copy to .env and adjust. docker compose reads it automatically.

# ROS 2 network (must match the UGV)
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp      # or rmw_cyclonedds_cpp (uses cyclonedds.xml)

# Folders on this machine
MODELS_DIR=./models                      # yoloe-v8l-seg.pt, sam3.pt, bpe_simple_vocab_16e6.txt.gz, masa_r50.pth
SUPPORTS_DIR=./supports                  # support bank (bank.json + images/masks)

# Map manager upload (crispres). Off by default so tests never write to the live map.
API_ENABLED=false
CRISPRES_API_TOKEN=

# Container user. 0 (root) matches the earlier live deployment (DDS shared memory with root
# publishers); set to your uid/gid (id -u / id -g) to own outputs/ as yourself.
UGV_UID=0
UGV_GID=0

# Extra CLI arguments, e.g. UGV_ARGS=--set detector.backend=sam3 --set position.heading_offset_deg=5
UGV_CONFIG=configs/default.yaml
UGV_ARGS=

# Replay (docker compose --profile replay run --rm replay)
BAG_PATH=./bags
BAG_RATE=1.0
BAG_ARGS=
